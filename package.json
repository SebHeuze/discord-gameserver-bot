{
  "name": "discord-gameserver-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Bot Discord de contrôle des serveurs de jeux du homelab, via l'API Komodo",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "gamedig": "^5.3.3",
    "undici": "^7.29.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/gamedig": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
